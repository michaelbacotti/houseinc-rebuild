# houseinc501c3.com — CF Pages redirects
# No legacy .html pages exist in this build, so the old *.html -> */
# catch-all is no longer needed.

# NOTE: rules are evaluated top to bottom, first match wins.
# The /* catch-all MUST stay last or it shadows every rule below it.

# Old served files removed in the v2 rebuild — direct-upload deploys keep
# stale files live, so redirect them explicitly.
/nav.js / 301
/footer.js / 301
/generate_sitemap.py / 301
/_SITE-MEMORY.md / 301
/.gitignore / 301

# Root index (legacy file at root)
/index.html / 301

# No-slash -> slash (301 permanent)
/apply /apply/ 301
/board /board/ 301
/contact /contact/ 301
/donate /donate/ 301
/mission /mission/ 301
/programs /programs/ 301
/stories /stories/ 301
/transparency /transparency/ 301

# Catch-all (LAST): any random path -> 404
/* /404.html 404
